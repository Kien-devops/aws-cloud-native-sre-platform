{
  "title": "SLO and Error Budget",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "tags": ["sre", "slo"],
  "panels": [
    {"type": "stat", "title": "Availability (30d)", "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0}, "targets": [{"expr": "1 - (sum(increase(http_requests_total{status=~\"5..\"}[30d])) / clamp_min(sum(increase(http_requests_total[30d])), 1))", "format": "time_series"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}}},
    {"type": "stat", "title": "Error budget remaining", "gridPos": {"h": 6, "w": 8, "x": 8, "y": 0}, "targets": [{"expr": "1 - (sum(increase(http_requests_total{status=~\"5..\"}[30d])) / clamp_min(sum(increase(http_requests_total[30d])) * 0.001, 1))", "format": "time_series"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}}},
    {"type": "timeseries", "title": "Burn rate (1h)", "gridPos": {"h": 8, "w": 16, "x": 0, "y": 6}, "targets": [{"expr": "(sum(rate(http_requests_total{status=~\"5..\"}[1h])) / clamp_min(sum(rate(http_requests_total[1h])), 1e-9)) / 0.001", "legendFormat": "burn rate"}]}
  ]
}
